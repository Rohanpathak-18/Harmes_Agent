PORT=5000
NODE_ENV=development

MONGO_URI=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

CLIENT_URL=http://localhost:5173

# Gmail example: smtp.gmail.com / 465 / true. Use a Google App Password,
# not your regular Google account password. Never commit real credentials.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-address@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_FROM=Hermes <your-address@gmail.com>
